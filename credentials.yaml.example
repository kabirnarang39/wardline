identities:
  - name: agent-abc123
    secret: "replace-with-a-long-random-registration-secret"
    tenant: acme   # optional -- omitting it defaults to the "default" tenant.
                   # A load-bearing field once features.rbac/budget_enforcement/
                   # anomaly_detection use tenant-scoped rules or overrides --
                   # see README.md "RBAC".
  # Only one of `secret` (bootstrap_source: presharedsecret, the default --
  # loaded above) or `spiffe_id` (bootstrap_source: mtls) is ever read by a
  # single Wardline instance -- each loader requires every entry to have
  # its own field, so mixing them in one live file makes it unloadable by
  # BOTH sources. The block below is commented out for that reason; if
  # you're running bootstrap_source: mtls, uncomment it in a
  # credentials.yaml of its own (or replace the secret-based entries
  # above -- don't run both shapes in the same file).
  # - name: payments-worker
  #   spiffe_id: "spiffe://example.org/ns/prod/sa/payments-worker"
  #   # spiffe_id (instead of secret) is only read when credential.bootstrap_source
  #   # is "mtls" -- an already-verified SPIFFE ID forwarded by a terminating
  #   # mTLS proxy/mesh, matched instead of a preshared secret. See README.md
  #   # "mTLS/SPIFFE bootstrap".
  #   tenant: acme   # optional, same default as above
