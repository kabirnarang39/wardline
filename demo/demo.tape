# vhs tape for the Wardline demo GIF.
#   Regenerate with:  make demo-gif   (or: vhs demo/demo.tape)
# Records ./demo/run.sh into docs/images/wardline-demo.gif.
Output docs/images/wardline-demo.gif

Set Shell bash
Set FontSize 15
Set Width 1280
Set Height 860
Set Theme "Dracula"
Set Margin 16
Set BorderRadius 8
Set Padding 16

Type "./demo/run.sh"
Enter
Sleep 34s
