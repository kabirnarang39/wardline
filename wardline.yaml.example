listen: ":8080"
upstream: "http://localhost:9000"
policy_file: "./policy.yaml.example"
# policy_backend: yaml   # "yaml", "opa", or "cedar" — see policy.rego.example, policy.cedar.example, and README.md
audit:
  output: stdout
features: {}
# features:
#   budget_enforcement: true   # off by default — see README.md "Budget enforcement"
#   otel_tracing: true         # off by default — see README.md "Tracing"
#   web_ui: true               # off by default — see README.md "Dashboard"
#   postgres_storage: true     # off by default — see README.md "Postgres storage"
#   credential_issuance: true  # off by default — see README.md "Credential issuance"
#   rbac: true                 # off by default — see README.md "RBAC"
#   anomaly_detection: true    # off by default — see README.md "Anomaly detection"
#   federation: true           # off by default, requires anomaly_detection — see README.md "Federation"
# audit:
#   postgres_dsn: "postgres://user:pass@localhost:5432/wardline?sslmode=disable"
#   # only used when features.postgres_storage is true; audit.output is
#   # ignored (with a warning log) when this flag is on
# budget:
#   requests_per_window: 100
#   window_seconds: 60
# tracing:
#   otlp_endpoint: "localhost:4318"   # required — host:port, no scheme, plaintext OTLP/HTTP
#   service_name: "wardline"          # optional — defaults to "wardline"
# credential:
#   identities_file: "./credentials.yaml.example"
#   # required when features.credential_issuance is true
# rbac:
#   config_file: "./rbac.yaml.example"
#   # required when features.rbac is true
# anomaly:
#   output: "./anomaly.jsonl"
#   # required when features.anomaly_detection is true, and must not be the
#   # same file as audit.output — the two streams have different schemas
#   buffer_capacity: 1000        # optional — how many recent anomalies
#                                # /dashboard/api/anomalies can serve; defaults to 1000
#   gc_interval_seconds: 600     # optional — how often stale per-identity state is
#                                # dropped (anything unseen for 2x this); defaults to 600
#   window_seconds: 60
#   rate_spike:
#     enabled: true
#     rate_multiplier: 3.0
#     min_calls: 10
#   novel_tool:
#     enabled: true
#   deny_rate_spike:
#     enabled: true
#     threshold: 0.5
#     min_calls: 5
# federation:
#   peers_file: "./peers.yaml"
#   signing_key_file: "./federation-signing-key.pem"
#   shared_secret_file: "./federation-shared-secret"
#   # all three required when features.federation is true — see README.md "Federation"
#   publish_interval_seconds: 60
#   min_instances_for_correlation: 2   # must be >= 2
#   correlation_window_seconds: 300
#   gc_interval_seconds: 600
